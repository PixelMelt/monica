# The Rust server reads these from the environment or from a `.env` file in
# the directory it starts in (see rust/README.md).

# `production`, `local` or `testing`.
APP_ENV=production
# https here makes the session cookies `Secure`.
APP_URL=http://localhost:8080
# 32 bytes, base64: `monica key-generate` prints one.
APP_KEY=
APP_LOCALE=en

BIND=0.0.0.0:8080
# Uploaded files and, by default, the SQLite database.
DATA_DIR=data
# Default: sqlite://$DATA_DIR/monica.sqlite?mode=rwc. Or mysql://…, postgres://…
DATABASE_URL=
# The built SPA (`yarn build` writes dist/).
SPA_DIR=dist

# Megabytes per uploaded file.
MAX_UPLOAD_SIZE=10
# Minutes of inactivity before a session ends.
SESSION_LIFETIME=120

# Summaries on the city and country reports; empty disables them.
WIKIPEDIA_URL=https://{lang}.wikipedia.org/w/api.php
